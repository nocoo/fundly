{
  "name": "fundly",
  "version": "0.1.2",
  "module": "src/index.ts",
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/bun": "^1.3.14",
    "typescript": "7.0.2"
  },
  "description": "中国公募基金全市场数据采集与量化选基工具 (MVP: 主动权益基金)",
  "private": true,
  "scripts": {
    "fetch:list": "bun run scripts/fetch-fund-list.ts",
    "fetch:nav": "bun run scripts/fetch-fund-nav.ts",
    "fetch:daily": "bun run scripts/fetch-daily.ts",
    "fetch:all": "bun run scripts/fetch-all.ts",
    "rank:refresh": "bun run scripts/refresh-ranks.ts",
    "db:init": "bun run scripts/init-db.ts",
    "backup": "bun run scripts/backup.ts",
    "restore": "bun run scripts/restore.ts",
    "install:web": "bun install --cwd apps/web && bun install --cwd apps/worker",
    "dev:api": "bun run apps/worker/scripts/dev-api.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:all": "bun run scripts/dev-all.ts",
    "build:web": "bun run --cwd apps/web build",
    "lint": "biome check src scripts tests apps",
    "lint:fix": "biome check --write src scripts tests apps",
    "format": "biome format --write src scripts tests apps",
    "test": "bun test tests src",
    "test:web": "bun test apps",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "typecheck:web": "bun run --cwd apps/web typecheck && bun run --cwd apps/worker typecheck",
    "release": "bun run scripts/release.ts"
  },
  "type": "module"
}
