{
  "name": "fundly",
  "version": "0.1.0",
  "module": "src/index.ts",
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/bun": "^1.3.14",
    "typescript": "7.0.2"
  },
  "description": "中国公募基金全市场数据采集与量化选基工具 (MVP: 主动权益基金)",
  "private": true,
  "scripts": {
    "fetch:list": "bun run scripts/fetch-fund-list.ts",
    "fetch:nav": "bun run scripts/fetch-fund-nav.ts",
    "fetch:all": "bun run scripts/fetch-all.ts",
    "db:init": "bun run scripts/init-db.ts",
    "lint": "biome check src scripts tests",
    "lint:fix": "biome check --write src scripts tests",
    "format": "biome format --write src scripts tests",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "typecheck": "tsc --noEmit"
  },
  "type": "module"
}
