{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fundly",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "fundly.hexly.ai", "custom_domain": true }
  ],
  "vars": {
    "ENVIRONMENT": "production"
  },
  "assets": {
    "directory": "./static",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fundly-db",
      "database_id": "ccc8336d-8c39-489a-a532-2ea856ec69ed",
      "migrations_dir": "migrations"
    }
  ]
}
