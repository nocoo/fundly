{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "scripts/backup.ts",
    "scripts/restore.ts",
    "src/backup/**/*.ts",
    "apps/worker/scripts/**/*.ts",
    "apps/worker/scripts/sqlite-bindings.ts",
    "apps/worker/src/lib/executor.ts",
    "apps/worker/src/lib/fund-query.ts",
    "apps/worker/src/lib/fund-detail.ts",
    "apps/worker/src/lib/funds-service.ts",
    "apps/worker/src/lib/version.ts"
  ]
}
